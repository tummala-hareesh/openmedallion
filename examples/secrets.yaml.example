# secrets.yaml.example — shared credentials template for all examples.
#
# Copy this file to examples/secrets.yaml and fill in your values:
#
#   cp secrets.yaml.example secrets.yaml
#
# secrets.yaml is gitignored — never commit real credentials.
#
# Usage in any example:
#   1. Fill in the relevant block below (oracle, postgres, mysql, or mssql)
#   2. Set `dialect: oracle` (or postgres, etc.) in the project's bronze.yaml
#   3. Run the pipeline — credentials are read from this file automatically
#
# SQLite does not belong here: it has no credentials.
# For SQLite demos, the path is set directly in bronze.yaml via connection_string.

# ── Oracle ───────────────────────────────────────────────────────────────────
oracle:
  host:     your-oracle-host
  port:     1521
  service:  XE                 # or your service/SID name
  username: hr
  password: your_password_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
postgres:
  host:     your-postgres-host
  port:     5432
  database: your_database
  username: your_user
  password: your_password_here

# ── MySQL ─────────────────────────────────────────────────────────────────────
mysql:
  host:     your-mysql-host
  port:     3306
  database: your_database
  username: your_user
  password: your_password_here

# ── SQL Server ────────────────────────────────────────────────────────────────
mssql:
  host:     your-mssql-host
  port:     1433
  database: your_database
  username: your_user
  password: your_password_here
  driver:   ODBC+Driver+17+for+SQL+Server   # optional, this is the default
